<?xml version="1.0" ?>
<robot name="mug_tree">
  <link name="_name">
   
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="mug_tree.obj" scale="1 1 1" />
      </geometry>
      <material name="wood_brown">
        <color rgba="0.5 0.35 0.05 1.0" />
      </material>
    </visual>
    
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <mesh filename="mug_tree.obj" scale="1 1 1" />
      </geometry>
    </collision>
    
    <inertial>
      <origin rpy="0 0 0" xyz="0.0 0.0 0.0" />
      <mass value="0.5" />
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0" />
    </inertial>
    
  </link>
</robot>
